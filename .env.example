# ===== 大模型配置 =====
# OpenCode Go API Key（必填，从 OpenCode Console 获取）
OPENCODE_API_KEY=your_opencode_go_api_key

# OpenCode Go 的 OpenAI 兼容地址
BASE_URL=https://opencode.ai/inference/go/openai/v1

# OpenCode Go 路由/缓存用的稳定 session ID
OPENCODE_SESSION_ID=ses_mnemo_local_000000000000
OPENCODE_USER_AGENT=mnemo/0.1

# DeepSeek V4.1 Flash 的 reasoning 开关；none 可降低延迟
OPENCODE_REASONING_EFFORT=none

# Agent 主模型（DeepSeek V4.1 Flash）
AGENT_BASE_MODEL=deepseek-v4.1-flash

# DashScope API Key（embedding + rerank 仍使用）
DASHSCOPE_API_KEY=your_dashscope_api_key

# 服务端默认召回父块数（请求可用 top_k 覆盖；评测会把实际值写进 meta）
AGENT_TOP_K=5

# 生成温度（评测复现建议设为 0；默认 0.7 保留演示时的表达多样性）
AGENT_TEMPERATURE=0.7

# 记忆提取模型（后台任务使用，建议用小模型节省成本）
SUMMARIZATION_MODEL=deepseek-v4.1-flash

# ===== 嵌入模型配置 =====
# 文本向量化模型（用于知识库和记忆的语义检索）
EMBEDDING_MODEL=text-embedding-v4

# 向量维度（text-embedding-v4 为 1024 维）
dense_dimension=1024

# ===== Rerank 重排序配置 =====
# 重排序模型（用于优化检索结果的相关性排序）
RERANK_MODEL=qwen3.7-text-rerank

# 重排序 API 地址
RERANK_URL=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank

# 重排序 API Key（默认与 DASHSCOPE_API_KEY 相同）
RERANK_API_KEY=your_dashscope_api_key

# ===== 答案评测 Judge（可选） =====
# 默认使用 DashScope qwen-plus，避免与生成模型同源；也可改成 OpenCode Go
JUDGE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
JUDGE_MODEL=qwen-plus
JUDGE_API_KEY=your_dashscope_api_key

# ===== Milvus 向量数据库配置 =====
# Zilliz Cloud 服务地址（或自建 Milvus 地址）
Milvus_url=your_milvus_url

# 认证 Token（Zilliz Cloud 格式：username:password）
Token=your_milvus_token

# 知识库集合名称
knowledge_base_collection=knowledge_base_collection

# 记忆集合名称
memory_collection=memory_collection

# ===== PostgreSQL 数据库配置 =====
# 完整连接字符串（包含用户名、密码、主机、端口、数据库名）
DATABASE_URL=postgresql://user:pass@localhost:5432/mnemo_db?sslmode=disable

# 分项配置（用于程序自动创建数据库）
user=your_db_user
password=your_db_password
host=localhost
port=5432
db_name=mnemo_db

# ===== Redis 配置 =====
# Redis 连接地址（用于对话检查点存储和用户画像缓存）
REDIS_URL=redis://localhost:6379/0

# ===== 临时文件目录 =====
# 文档上传后的临时存储路径
TEMP_DIR=./temp

# ===== Agentic-lite 检索配置 =====
# 总开关：false 时 deep/auto 一律降级为 fast（回滚路径）
AGENTIC_ENABLED=true
# 未显式传 retrieval_mode 时的默认模式（auto/fast/deep），仅 api.py 消费
AGENTIC_DEFAULT_MODE=fast
# deep 最大反思轮次（1-3）
AGENTIC_MAX_ROUNDS=2
# deep 总超时预算毫秒（3000-20000）
AGENTIC_TIMEOUT_MS=12000
# deep 每轮最多检索查询数（1-3）
AGENTIC_MAX_QUERIES=3
