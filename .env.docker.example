# 复制为 .env 后填写。
# 本地 Docker（PostgreSQL + Redis Stack）已经配好；Milvus、OpenCode Go 和 DashScope 需要你自己填。

# ===== OpenCode Go（LLM）=====
OPENCODE_API_KEY=sk-opencode-go-xxxxxxxx
BASE_URL=https://opencode.ai/inference/go/openai/v1
OPENCODE_SESSION_ID=ses_mnemo_local_000000000000
OPENCODE_USER_AGENT=mnemo/0.1
OPENCODE_REASONING_EFFORT=none
AGENT_BASE_MODEL=deepseek-v4.1-flash

# ===== DashScope（embedding + rerank）=====
DASHSCOPE_API_KEY=sk-xxxxxxxx
# 服务端默认召回父块数（请求可用 top_k 覆盖；评测会把实际值写进 meta）
AGENT_TOP_K=5
# 生成温度（评测复现建议设为 0；默认 0.7 保留演示时的表达多样性）
AGENT_TEMPERATURE=0.7
# 记忆抽取模型；当前使用 DeepSeek V4.1 Flash
SUMMARIZATION_MODEL=deepseek-v4.1-flash

# ===== 向量化 =====
EMBEDDING_MODEL=text-embedding-v4
dense_dimension=1024

# ===== Rerank =====
RERANK_MODEL=qwen3.7-text-rerank
RERANK_URL=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
RERANK_API_KEY=sk-xxxxxxxx

# ===== 答案评测 Judge（可选）=====
JUDGE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
JUDGE_MODEL=qwen-plus
JUDGE_API_KEY=sk-xxxxxxxx

# ===== Milvus（推荐 Zilliz 免费集群）=====
Milvus_url=https://in03-xxxxxxxx.serverless.ali-cn-hangzhou.cloud.zilliz.com.cn
Token=username:password
knowledge_base_collection=knowledge_base_collection
memory_collection=memory_collection

# ===== PostgreSQL（docker compose 默认值）=====
DATABASE_URL=postgresql://mnemo:mnemo@localhost:5432/mnemo_db
user=mnemo
password=mnemo
host=localhost
port=5432
db_name=mnemo_db

# ===== Redis Stack（docker compose 默认值）=====
REDIS_URL=redis://localhost:6379/0

# ===== 其他 =====
TEMP_DIR=./temp
